        "createdAt": "2026-10-06T09:00:00.000Z",
        "updatedAt": "2026-10-06T09:00:00.000Z",
        "projectId": "proj-supplier",
        "kind": "user-story",
        "title": "Block duplicate supplier by Tax ID",
        "description": "As an AP specialist, I want duplicate Tax IDs to be blocked so duplicate supplier records are not created.",
        "acceptanceCriteria": [
          "An existing Tax ID blocks creation.",
          "The existing supplier is identified in the error response.",
          "No new AP_SUPPLIERS row is created."
        ],
        "status": "approved",
        "parentId": "req-feature",
        "functionalityIds": [
          "fn-create"
        ],
        "priority": "high"
