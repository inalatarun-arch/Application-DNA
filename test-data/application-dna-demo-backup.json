        "id": "req-create",
        "createdAt": "2026-10-06T09:00:00.000Z",
        "updatedAt": "2026-10-06T09:00:00.000Z",
        "projectId": "proj-supplier",
        "kind": "user-story",
        "title": "Create supplier from onboarding request",
        "description": "As a procurement user, I want to submit a completed onboarding request so that a supplier can be created in Oracle EBS without re-keying data.",
        "acceptanceCriteria": [
          "Given mandatory fields are complete, submission sends the request through MuleSoft to the EBS Supplier API.",
          "Given EBS accepts the request, the onboarding request stores the returned vendor ID.",
          "The Tax ID is passed unchanged from Salesforce to EBS."
        ],
        "status": "approved",
        "parentId": "req-feature",
        "functionalityIds": [
          "fn-submit",
          "fn-create"
        ],
        "priority": "high"
      },
      {
