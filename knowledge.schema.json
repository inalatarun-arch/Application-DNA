{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/application-dna/knowledge.schema.json",
  "title": "Application DNA knowledge model",
  "description": "Shape of the records the Knowledge Repository stores: applications, captures and knowledge items.",
  "type": "object",
  "properties": {
    "apps": { "type": "array", "items": { "$ref": "#/$defs/application" } },
    "captures": { "type": "array", "items": { "$ref": "#/$defs/capture" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "application": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "integer", "description": "Unix time in milliseconds" }
      }
    },
    "capture": {
      "type": "object",
      "required": ["id", "appId", "kind", "title"],
      "properties": {
        "id": { "type": "string" },
        "appId": { "type": "string" },
        "kind": { "enum": ["note", "document"] },
        "title": { "type": "string" },
        "chars": { "type": "integer", "minimum": 0 },
        "itemCount": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "integer" }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "appId", "type", "name", "status"],
      "properties": {
        "id": { "type": "string" },
        "appId": { "type": "string" },
        "captureId": { "type": "string" },
        "captureTitle": { "type": "string" },
        "type": {
          "enum": ["module", "screen", "functionality", "business_rule", "integration", "api", "database_object", "open_question"]
        },
        "name": { "type": "string", "maxLength": 300 },
        "parent": { "type": "string", "description": "Exact name of the item this one belongs to. Empty when unknown." },
        "description": { "type": "string", "maxLength": 600 },
        "details": {
          "type": "object",
          "properties": {
            "purpose": { "type": "string" },
            "roles": { "$ref": "#/$defs/stringList" },
            "inputs": { "$ref": "#/$defs/stringList" },
            "outputs": { "$ref": "#/$defs/stringList" },
            "rules": { "$ref": "#/$defs/stringList" },
            "validations": { "$ref": "#/$defs/stringList" },
            "exceptions": { "$ref": "#/$defs/stringList" },
            "notes": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rel", "target"],
            "properties": {
              "rel": { "enum": ["depends_on", "integrates_with", "calls", "reads", "writes", "triggers", "related_to"] },
              "target": { "type": "string", "description": "Exact name of another item" }
            }
          }
        },
        "evidence": { "type": "string", "maxLength": 300, "description": "Short quote from the source text" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "enum": ["pending", "approved"] },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "title": { "type": "string" }, "excerpt": { "type": "string" } }
          }
        },
        "createdAt": { "type": "integer" },
        "approvedAt": { "type": "integer" }
      }
    },
    "stringList": { "type": "array", "items": { "type": "string" }, "maxItems": 12 }
  }
}
